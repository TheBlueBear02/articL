# Copy this file to .env and fill in your own keys. .env is git-ignored.
# Used by the spike scripts (scripts/) and the web app (app/ loads this file).

OPENAI_API_KEY=
PIXABAY_API_KEY=

# Supabase dashboard -> Project Settings -> API Keys.
# (New sb_publishable_/sb_secret_ keys or legacy anon/service_role keys both work.)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Use the local Inngest dev server. Remove when deploying.
INNGEST_DEV=1

# Optional: OpenAI model for proposing points (default gpt-5-mini; gpt-5-nano is cheaper but weaker)
OPENAI_MODEL=

# Optional: local render quality: draft (default, fastest) | looks | delivery
RENDER_QUALITY=
